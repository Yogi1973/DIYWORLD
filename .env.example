# PostgreSQL Connection String
# Get free PostgreSQL at https://neon.tech or https://railway.app
# Format: postgresql://user:password@host:port/database
DATABASE_URL=

# JWT Secret for authentication (generate with: openssl rand -base64 32)
JWT_SECRET=

# Admin setup (set after first admin creation)
ADMIN_EMAIL=admin@diyworld.local
ADMIN_PASSWORD_HASH=

# Razorpay Payment (optional - set up at https://razorpay.com)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_SECRET_KEY=

# Payment method configuration
NEXT_PUBLIC_ENABLE_COD=true
NEXT_PUBLIC_ENABLE_RAZORPAY=false

# Store configuration
NEXT_PUBLIC_STORE_NAME=DIY World
NEXT_PUBLIC_STORE_URL=http://localhost:3000
